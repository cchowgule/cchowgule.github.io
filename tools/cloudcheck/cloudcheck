#!/usr/bin/env bash
# cloudcheck - verify that two folders (e.g. Dropbox and Google Drive) hold the same files.
#
# Uses rclone to list both sides. By default only file names (relative paths) are
# compared; file contents are not read.
#
# Runs on Linux and macOS. Written for bash >= 3.2 (macOS /bin/bash) and
# POSIX/BSD userland tools: no associative arrays, no `sed -i`, no GNU-only flags.
#
# Exit codes: 0 = match, 1 = differences found, 2 = usage/dependency/runtime error.

set -euo pipefail

PROG=${0##*/}
VERSION=2.0.0
MIN_RCLONE_MAJOR=1
MIN_RCLONE_MINOR=52   # first release with `rclone check --combined`

mode="names"     # names | size | checksum | download
one_way=0
ignore_case=0
quiet=0
verbose=0
preflight_only=0
report=""
excludes=()
src=""
dst=""
npos=0

usage() {
  cat <<EOF
Usage: $PROG [options] SOURCE DEST
       $PROG --preflight [SOURCE DEST]

Check that SOURCE and DEST contain the same file names, and list any file that
exists on only one side. Paths are rclone remotes (e.g. dropbox:Photos,
gdrive:Backup/Photos); local directories also work.

By default only names are compared (fast: listings only, no file contents read).

Options:
  -i, --ignore-case     Treat names differing only in letter case as the same
  -1, --one-way         Only report files in SOURCE that are missing from DEST
  -x, --exclude PATTERN Exclude files matching PATTERN (repeatable)
  -r, --report FILE     Also write the full per-file result list to FILE
  -p, --preflight       Check all dependencies (and paths, if given), then exit
  -q, --quiet           Print only the summary
  -v, --verbose         Also list matching files and show the underlying commands
  -h, --help            Show this help
  -V, --version         Show version

Optional content checks (off by default; these also report files that differ):
  -s, --size-only       Also compare file sizes
  -c, --checksum        Also compare hashes (uses a hash type both sides support,
                        else falls back to size; Dropbox and Drive share none)
  -d, --download        Download both sides and compare bytes

Result markers (used in --report files):
  =  same on both sides   *  content differs (content checks only)
  +  only in SOURCE       -  only in DEST
  !  error reading file

Examples:
  $PROG --preflight
  $PROG dropbox:Photos gdrive:Photos
  $PROG -i -x '.DS_Store' dropbox:Docs gdrive:Docs
  $PROG -1 dropbox:Docs gdrive:Docs
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 2; }
log() { (( quiet )) || printf '%s\n' "$*" >&2; }

while (( $# )); do
  case $1 in
    -s|--size-only) mode=size ;;
    -c|--checksum)  mode=checksum ;;
    -d|--download)  mode=download ;;
    -i|--ignore-case) ignore_case=1 ;;
    -1|--one-way)   one_way=1 ;;
    -x|--exclude)   [[ $# -ge 2 ]] || die "$1 needs a value"; excludes+=("$2"); shift ;;
    -r|--report)    [[ $# -ge 2 ]] || die "$1 needs a value"; report=$2; shift ;;
    -p|--preflight) preflight_only=1 ;;
    -q|--quiet)     quiet=1 ;;
    -v|--verbose)   verbose=1 ;;
    -h|--help)      usage; exit 0 ;;
    -V|--version)   echo "$PROG $VERSION"; exit 0 ;;
    --)             shift
                    while (( $# )); do
                      npos=$((npos + 1)); [[ $npos == 1 ]] && src=$1 || dst=$1; shift
                    done
                    break ;;
    -?*)            die "unknown option: $1 (see --help)" ;;
    *)              npos=$((npos + 1)); [[ $npos == 1 ]] && src=$1 || dst=$1 ;;
  esac
  shift
done

if (( preflight_only )); then
  (( npos == 0 || npos == 2 )) || { usage >&2; exit 2; }
else
  (( npos == 2 )) || { usage >&2; exit 2; }
fi

(( ignore_case )) && [[ $mode != names ]] && die "--ignore-case only applies to the default name comparison"

# rclone remote syntax is "name:path" with no '/' before the first ':'.
is_remote() {
  local p=$1
  [[ -z $p || $p == /* || $p == ./* || $p == ../* || $p == "~"* ]] && return 1
  [[ $p =~ ^[^/]*: ]]
}

# ---------------------------------------------------------------------------
# Preflight
# ---------------------------------------------------------------------------

os=$(uname -s 2>/dev/null || echo unknown)

install_hint() {
  # $1 = package name
  case $os in
    Darwin)
      if command -v brew >/dev/null 2>&1; then
        echo "brew install $1"
      else
        echo "install Homebrew (https://brew.sh), then: brew install $1"
      fi ;;
    Linux)
      if   command -v apt-get >/dev/null 2>&1; then echo "sudo apt install $1"
      elif command -v dnf     >/dev/null 2>&1; then echo "sudo dnf install $1"
      elif command -v pacman  >/dev/null 2>&1; then echo "sudo pacman -S $1"
      else echo "install $1 with your package manager"; fi ;;
    *) echo "install $1 with your package manager" ;;
  esac
}

pf_fail=0
pf_report=0   # 1 = print OK lines too (--preflight / --verbose)
pf_ok()   { (( pf_report )) && printf '  [ok]   %s\n' "$*" >&2; return 0; }
pf_warn() { printf '  [warn] %s\n' "$*" >&2; }
pf_err()  { printf '  [FAIL] %s\n' "$*" >&2; pf_fail=1; }

check_bash() {
  local maj=${BASH_VERSINFO[0]} min=${BASH_VERSINFO[1]}
  if (( maj > 3 || (maj == 3 && min >= 2) )); then
    pf_ok "bash $BASH_VERSION"
  else
    pf_err "bash $BASH_VERSION is too old (need >= 3.2)"
  fi
}

check_coreutils() {
  local t missing=""
  for t in awk mktemp mkdir sort cut grep sed tr cp mv rm uname; do
    command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
  done
  if [[ -n $missing ]]; then
    pf_err "missing core tools:$missing"
  else
    pf_ok "core tools (awk mktemp sort cut grep sed)"
  fi
}

check_rclone() {
  if ! command -v rclone >/dev/null 2>&1; then
    pf_err "rclone not found -> $(install_hint rclone), then: rclone config"
    return
  fi
  # sed (not head) reads all input, so rclone never gets SIGPIPE under pipefail.
  local v; v=$(rclone version 2>/dev/null | sed -n 1p) || v=""
  if [[ $v =~ v([0-9]+)\.([0-9]+) ]]; then
    local maj=${BASH_REMATCH[1]} min=${BASH_REMATCH[2]}
    if (( maj > MIN_RCLONE_MAJOR || (maj == MIN_RCLONE_MAJOR && min >= MIN_RCLONE_MINOR) )); then
      pf_ok "$v"
    else
      pf_err "$v is too old (need >= v$MIN_RCLONE_MAJOR.$MIN_RCLONE_MINOR) -> $(install_hint rclone)"
    fi
  else
    pf_warn "rclone found but version could not be read; continuing"
  fi
}

check_remote() {
  # $1 = path; verifies that its remote name is configured in rclone.
  local p=$1 name
  is_remote "$p" || return 0
  name=${p%%:*}
  [[ -z $name ]] && return 0   # on-the-fly backend such as ":local:/path"
  command -v rclone >/dev/null 2>&1 || return 0
  if rclone listremotes 2>/dev/null | grep -Fqx "$name:"; then
    pf_ok "rclone remote '$name:' is configured"
  else
    local have; have=$(rclone listremotes 2>/dev/null | tr '\n' ' ')
    pf_err "rclone remote '$name:' not found -> run: rclone config  (configured: ${have:-none})"
  fi
}

check_local_dir() {
  local p=$1
  [[ -z $p ]] && return 0
  is_remote "$p" && return 0
  if [[ -d $p ]]; then pf_ok "directory exists: $p"; else pf_err "not a directory: $p"; fi
}

check_jq() {
  if command -v jq >/dev/null 2>&1; then
    pf_ok "jq $(jq --version 2>/dev/null)"
  else
    pf_warn "jq not found (optional; enables the Dropbox/Drive hash-compatibility warning for --checksum) -> $(install_hint jq)"
  fi
}

# $1 = all (report every optional check too) | run (only what this run needs)
preflight() {
  local which=$1
  (( pf_report )) && printf 'Preflight (%s):\n' "$os" >&2
  check_bash
  check_coreutils
  check_rclone
  if [[ $which == all || $mode == checksum ]]; then check_jq; fi
  check_remote "$src"; check_remote "$dst"
  check_local_dir "$src"; check_local_dir "$dst"
  if (( pf_fail )); then
    printf '%s: preflight failed; fix the items marked FAIL above.\n' "$PROG" >&2
    exit 2
  fi
  (( pf_report )) && printf 'Preflight passed.\n' >&2
  return 0
}

if (( preflight_only )); then
  pf_report=1
  preflight all
  exit 0
fi

pf_report=$verbose
preflight run

tmpbase=${TMPDIR:-/tmp}
work=$(mktemp -d "$tmpbase/cloudcheck.XXXXXX")
trap 'rm -rf "$work"' EXIT
results=$work/results
errlog=$work/errors
: >"$results"

# ---------------------------------------------------------------------------
# Listing (names only)
# ---------------------------------------------------------------------------

# list_files PATH -> sorted, de-duplicated relative file paths on stdout.
# Directories are not listed; a folder that is empty on one side is not a difference.
list_files() {
  local p=$1 x rc=0
  # ${arr[@]+...} guards against "unbound variable" on empty arrays in bash < 4.4.
  local args=(lsf -R --files-only)
  for x in ${excludes[@]+"${excludes[@]}"}; do args+=(--exclude "$x"); done
  (( verbose )) && log "+ rclone ${args[*]} $p"
  rclone "${args[@]}" "$p" 2>"$errlog" >"$work/list.raw" || rc=$?
  if (( rc != 0 )); then
    cat "$errlog" >&2
    die "could not list $p (exit $rc)"
  fi
  grep -v '/$' "$work/list.raw" | sort -u || true
}

# names_diff A B MARKER [in] -> lines in A whose name is not in B (or, with "in",
# whose name is in B), prefixed with MARKER.
names_diff() {
  awk -v ic="$ignore_case" -v m="$3" -v want="${4:-out}" '
    function k(s) { return ic ? tolower(s) : s }
    NR == FNR { seen[k($0)] = 1; next }
    ((k($0) in seen) == (want == "in")) { print m " " $0 }
  ' "$2" "$1"
}

run_names() {
  list_files "$src" >"$work/src.lst"
  list_files "$dst" >"$work/dst.lst"
  names_diff "$work/src.lst" "$work/dst.lst" '+' >>"$results"
  (( one_way )) || names_diff "$work/dst.lst" "$work/src.lst" '-' >>"$results"
  names_diff "$work/src.lst" "$work/dst.lst" '=' in >>"$results"
}

# ---------------------------------------------------------------------------
# Content checks (opt-in)
# ---------------------------------------------------------------------------

common_hashes() {
  # Prints the shared hash types, empty if none, or "unknown" if they can't be determined.
  command -v jq >/dev/null || { echo unknown; return; }
  local a b
  a=$(rclone backend features "$src" 2>/dev/null | jq -c '.Hashes // []') || { echo unknown; return; }
  b=$(rclone backend features "$dst" 2>/dev/null | jq -c '.Hashes // []') || { echo unknown; return; }
  jq -nr --argjson a "$a" --argjson b "$b" '($a - ($a - $b)) | join(",")'
}

run_rclone() {
  local args=(check "$src" "$dst" --combined "$results") x
  case $mode in
    size)     args+=(--size-only) ;;
    download) args+=(--download) ;;
    checksum)
      local h; h=$(common_hashes)
      if [[ -z $h ]]; then
        log "warning: $src and $dst share no hash type; rclone will compare sizes only."
        log "         Re-run with --download for a byte-level check (downloads both sides)."
      elif [[ $h != unknown ]] && (( verbose )); then
        log "common hashes: $h"
      fi
      ;;
  esac
  (( one_way )) && args+=(--one-way)
  for x in ${excludes[@]+"${excludes[@]}"}; do args+=(--exclude "$x"); done

  (( verbose )) && log "+ rclone ${args[*]}"

  # rclone logs every difference to stderr; keep it unless verbose or on failure.
  local rc=0
  if (( verbose )); then
    rclone "${args[@]}" || rc=$?
  else
    rclone "${args[@]}" 2>"$errlog" || rc=$?
  fi
  # rclone check: 0 = match, 1 = differences; anything else is an operational error.
  if (( rc > 1 )) || { (( rc == 1 )) && [[ ! -s $results ]]; }; then
    cat "$errlog" >&2
    die "rclone failed (exit $rc); check remote names with: rclone listremotes"
  fi
}

# ---------------------------------------------------------------------------
# Run and report
# ---------------------------------------------------------------------------

what="names"; [[ $mode != names ]] && what="names + $mode"
(( ignore_case )) && what="$what, ignoring case"
log "Comparing $what: $src  ->  $dst"

if [[ $mode == names ]]; then run_names; else run_rclone; fi

sort -k2 "$results" >"$results.sorted"
if (( one_way )); then
  grep -v '^- ' "$results.sorted" >"$results" || true
else
  mv "$results.sorted" "$results"
fi

count() { grep -c "^$1 " "$results" || true; }
n_same=$(count '=')
n_diff=$(count '\*')
n_src=$(count '+')
n_dst=$(count '-')
n_err=$(count '!')

# section MARKER TITLE COUNT
section() {
  (( $3 > 0 )) || return 0
  printf '\n%s (%s):\n' "$2" "$3"
  grep "^$1 " "$results" | cut -c3- | sed 's/^/  /'
}

if (( ! quiet )); then
  section '+'  "Only in $src" "$n_src"
  (( one_way )) || section '-' "Only in $dst" "$n_dst"
  section '\*' "Content differs" "$n_diff"
  section '!'  "Errors" "$n_err"
  (( verbose )) && section '=' "On both sides" "$n_same"
  (( n_src + n_dst + n_diff + n_err + verbose > 0 )) && echo
fi

[[ -n $report ]] && cp "$results" "$report"

summary="on-both-sides: $n_same  only-in-source: $n_src"
(( one_way )) || summary="$summary  only-in-dest: $n_dst"
[[ $mode != names ]] && summary="$summary  differ: $n_diff"
summary="$summary  errors: $n_err"
echo "$summary"

if (( n_diff + n_src + n_dst + n_err > 0 )); then
  echo "RESULT: MISMATCH"
  exit 1
fi
echo "RESULT: MATCH"
exit 0

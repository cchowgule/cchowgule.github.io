#!/usr/bin/env bash
# cloudcheck - verify that two folders (e.g. Dropbox and Google Drive) hold the same files.
#
# Engine selection (auto):
#   both paths local (e.g. ~/Dropbox vs a mounted Drive folder) -> rsync dry-run
#   any path is an rclone remote (remote:path)                  -> rclone check
#
# Runs on Linux and macOS. Written for bash >= 3.2 (macOS /bin/bash) and
# POSIX/BSD userland tools: no associative arrays, no `sed -i`, no GNU-only flags.
#
# Exit codes: 0 = match, 1 = differences found, 2 = usage/dependency/runtime error.

# shellcheck disable=SC2317  # run_rsync/run_rclone are called indirectly via "run_$engine"
set -euo pipefail

PROG=${0##*/}
VERSION=1.1.0
MIN_RCLONE_MAJOR=1
MIN_RCLONE_MINOR=52   # first release with `rclone check --combined`

engine=auto
mode="hash"      # hash | size | download
one_way=0
quiet=0
verbose=0
preflight_only=0
report=""
excludes=()
src=""
dst=""
npos=0

usage() {
  cat <<EOF
Usage: $PROG [options] SOURCE DEST
       $PROG --preflight [SOURCE DEST]

Check whether files in SOURCE match those in DEST.
Paths are either local directories or rclone remotes (e.g. dropbox:Photos, gdrive:Backup/Photos).

Options:
  -e, --engine ENGINE   auto | rsync | rclone (default: auto)
  -s, --size-only       Compare sizes only (fast, weakest)
  -d, --download        rclone: download and compare bytes (needed for Dropbox vs Drive,
                        which share no common hash type)
  -1, --one-way         Only report files in SOURCE that are missing/different in DEST
  -x, --exclude PATTERN Exclude files matching PATTERN (repeatable)
  -r, --report FILE     Also write the full per-file result list to FILE
  -p, --preflight       Check all dependencies (and remotes, if paths given), then exit
  -q, --quiet           Print only the summary
  -v, --verbose         Also list matching files and show the underlying command
  -h, --help            Show this help
  -V, --version         Show version

Output markers:
  =  identical            *  differs
  +  only in SOURCE       -  only in DEST
  !  error reading file

Examples:
  $PROG --preflight
  $PROG dropbox:Photos gdrive:Photos --download
  $PROG ~/Dropbox/Projects ~/GoogleDrive/Projects
  $PROG -1 -x '*.tmp' -r diff.txt dropbox:Docs gdrive:Docs
EOF
}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 2; }
log() { (( quiet )) || printf '%s\n' "$*" >&2; }

while (( $# )); do
  case $1 in
    -e|--engine)    [[ $# -ge 2 ]] || die "$1 needs a value"; engine=$2; shift ;;
    -s|--size-only) mode=size ;;
    -d|--download)  mode=download ;;
    -1|--one-way)   one_way=1 ;;
    -x|--exclude)   [[ $# -ge 2 ]] || die "$1 needs a value"; excludes+=("$2"); shift ;;
    -r|--report)    [[ $# -ge 2 ]] || die "$1 needs a value"; report=$2; shift ;;
    -p|--preflight) preflight_only=1 ;;
    -q|--quiet)     quiet=1 ;;
    -v|--verbose)   verbose=1 ;;
    -h|--help)      usage; exit 0 ;;
    -V|--version)   echo "$PROG $VERSION"; exit 0 ;;
    --)             shift
                    while (( $# )); do
                      npos=$((npos + 1)); [[ $npos == 1 ]] && src=$1 || dst=$1; shift
                    done
                    break ;;
    -?*)            die "unknown option: $1 (see --help)" ;;
    *)              npos=$((npos + 1)); [[ $npos == 1 ]] && src=$1 || dst=$1 ;;
  esac
  shift
done

if (( preflight_only )); then
  (( npos == 0 || npos == 2 )) || { usage >&2; exit 2; }
else
  (( npos == 2 )) || { usage >&2; exit 2; }
fi

# rclone remote syntax is "name:path" with no '/' before the first ':'.
is_remote() {
  local p=$1
  [[ -z $p || $p == /* || $p == ./* || $p == ../* || $p == "~"* ]] && return 1
  [[ $p =~ ^[^/]*: ]]
}

# ---------------------------------------------------------------------------
# Preflight
# ---------------------------------------------------------------------------

os=$(uname -s 2>/dev/null || echo unknown)

install_hint() {
  # $1 = package name
  case $os in
    Darwin)
      if command -v brew >/dev/null 2>&1; then
        echo "brew install $1"
      else
        echo "install Homebrew (https://brew.sh), then: brew install $1"
      fi ;;
    Linux)
      if   command -v apt-get >/dev/null 2>&1; then echo "sudo apt install $1"
      elif command -v dnf     >/dev/null 2>&1; then echo "sudo dnf install $1"
      elif command -v pacman  >/dev/null 2>&1; then echo "sudo pacman -S $1"
      else echo "install $1 with your package manager"; fi ;;
    *) echo "install $1 with your package manager" ;;
  esac
}

pf_fail=0
pf_report=0   # 1 = print OK lines too (--preflight / --verbose)
pf_ok()   { (( pf_report )) && printf '  [ok]   %s\n' "$*" >&2; return 0; }
pf_warn() { printf '  [warn] %s\n' "$*" >&2; }
pf_err()  { printf '  [FAIL] %s\n' "$*" >&2; pf_fail=1; }

check_bash() {
  local maj=${BASH_VERSINFO[0]} min=${BASH_VERSINFO[1]}
  if (( maj > 3 || (maj == 3 && min >= 2) )); then
    pf_ok "bash $BASH_VERSION"
  else
    pf_err "bash $BASH_VERSION is too old (need >= 3.2)"
  fi
}

check_coreutils() {
  local t missing=""
  for t in mktemp mkdir sort comm cut grep sed tr cp mv rm uname; do
    command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
  done
  if [[ -n $missing ]]; then
    pf_err "missing core tools:$missing"
  else
    pf_ok "core tools (mktemp sort comm cut grep sed)"
  fi
}

check_rclone() {
  if ! command -v rclone >/dev/null 2>&1; then
    pf_err "rclone not found -> $(install_hint rclone), then: rclone config"
    return
  fi
  # sed (not head) reads all input, so rclone never gets SIGPIPE under pipefail.
  local v; v=$(rclone version 2>/dev/null | sed -n 1p) || v=""
  if [[ $v =~ v([0-9]+)\.([0-9]+) ]]; then
    local maj=${BASH_REMATCH[1]} min=${BASH_REMATCH[2]}
    if (( maj > MIN_RCLONE_MAJOR || (maj == MIN_RCLONE_MAJOR && min >= MIN_RCLONE_MINOR) )); then
      pf_ok "$v"
    else
      pf_err "$v is too old (need >= v$MIN_RCLONE_MAJOR.$MIN_RCLONE_MINOR) -> $(install_hint rclone)"
    fi
  else
    pf_warn "rclone found but version could not be read; continuing"
  fi
}

check_remote() {
  # $1 = path; verifies that its remote name is configured in rclone.
  local p=$1 name
  is_remote "$p" || return 0
  name=${p%%:*}
  [[ -z $name ]] && return 0   # on-the-fly backend such as ":local:/path"
  command -v rclone >/dev/null 2>&1 || return 0
  if rclone listremotes 2>/dev/null | grep -Fqx "$name:"; then
    pf_ok "rclone remote '$name:' is configured"
  else
    local have; have=$(rclone listremotes 2>/dev/null | tr '\n' ' ')
    pf_err "rclone remote '$name:' not found -> run: rclone config  (configured: ${have:-none})"
  fi
}

check_local_dir() {
  local p=$1
  [[ -z $p ]] && return 0
  is_remote "$p" && return 0
  if [[ -d $p ]]; then pf_ok "directory exists: $p"; else pf_err "not a directory: $p"; fi
}

# Functional probe: the rsync shipped with macOS (openrsync, or 2.6.9 on older
# releases) may lack options this tool relies on, so test them rather than
# trusting the version string.
check_rsync() {
  if ! command -v rsync >/dev/null 2>&1; then
    pf_err "rsync not found -> $(install_hint rsync)"
    return
  fi
  local v; v=$(rsync --version 2>/dev/null | sed -n 1p) || v=""
  [[ -n $v ]] || v="rsync (unknown version)"
  local tdir out
  tdir=$(mktemp -d "${TMPDIR:-/tmp}/cloudcheck-probe.XXXXXX") || { pf_warn "could not create temp dir to probe rsync"; return; }
  mkdir "$tdir/a" "$tdir/b" || { rm -rf "$tdir"; pf_warn "could not create temp dir to probe rsync"; return; }
  echo x >"$tdir/a/new"; echo y >"$tdir/b/old"
  out=$(rsync -rn --checksum --delete --itemize-changes --out-format='%i %n' \
        --exclude='*.ignore' "$tdir/a/" "$tdir/b/" 2>&1) || true
  rm -rf "$tdir"
  if printf '%s\n' "$out" | grep -q '^>f+.* new$' && printf '%s\n' "$out" | grep -q 'deleting.*old'; then
    pf_ok "$v"
  else
    local hint; hint=$(install_hint rsync)
    [[ $os == Darwin ]] && hint="$hint  (the macOS system rsync lacks required options; ensure Homebrew's bin dir precedes /usr/bin in PATH)"
    pf_err "$v does not support the required options (--checksum --delete --itemize-changes --out-format) -> $hint"
  fi
}

check_jq() {
  if command -v jq >/dev/null 2>&1; then
    pf_ok "jq $(jq --version 2>/dev/null)"
  else
    pf_warn "jq not found (optional; enables the Dropbox/Drive hash-compatibility warning) -> $(install_hint jq)"
  fi
}

# $1 = which engines to check: all | rsync | rclone
preflight() {
  local which=$1
  (( pf_report )) && printf 'Preflight (%s):\n' "$os" >&2
  check_bash
  check_coreutils
  case $which in
    all)    check_rclone; check_rsync; check_jq ;;
    rclone) check_rclone; check_jq ;;
    rsync)  check_rsync ;;
  esac
  check_remote "$src"; check_remote "$dst"
  check_local_dir "$src"; check_local_dir "$dst"
  if (( pf_fail )); then
    printf '%s: preflight failed; fix the items marked FAIL above.\n' "$PROG" >&2
    exit 2
  fi
  (( pf_report )) && printf 'Preflight passed.\n' >&2
  return 0
}

if (( preflight_only )); then
  pf_report=1
  preflight all
  exit 0
fi

if [[ $engine == auto ]]; then
  if is_remote "$src" || is_remote "$dst"; then engine=rclone; else engine=rsync; fi
fi

case $engine in
  rsync)
    if is_remote "$src" || is_remote "$dst"; then
      die "rsync cannot read rclone remotes; use --engine rclone"
    fi
    [[ $mode == download ]] && die "--download applies to rclone only; rsync always reads local bytes"
    ;;
  rclone) ;;
  *) die "invalid engine: $engine" ;;
esac

pf_report=$verbose
preflight "$engine"

tmpbase=${TMPDIR:-/tmp}
results=$(mktemp "$tmpbase/cloudcheck.XXXXXX")
errlog=$(mktemp "$tmpbase/cloudcheck.XXXXXX")
trap 'rm -f "$results" "$results".* "$errlog"' EXIT

# Each engine writes lines of "<marker> <path>" into $results.
run_rsync() {
  local args=(-rn --itemize-changes --out-format='%i %n') x
  case $mode in
    hash) args+=(--checksum) ;;
    size) args+=(--size-only) ;;
  esac
  (( one_way )) || args+=(--delete)
  # ${arr[@]+...} guards against "unbound variable" on empty arrays in bash < 4.4.
  for x in ${excludes[@]+"${excludes[@]}"}; do args+=(--exclude="$x"); done

  (( verbose )) && log "+ rsync ${args[*]} ${src%/}/ ${dst%/}/"

  local out rc=0
  out=$(rsync "${args[@]}" "${src%/}/" "${dst%/}/" 2>&1) || rc=$?
  if (( rc != 0 && rc != 23 && rc != 24 )); then
    printf '%s\n' "$out" >&2
    die "rsync failed (exit $rc)"
  fi

  # Itemize codes: ">f+++..." new file, ">f..." changed file, "*deleting" extra in dest.
  local line code name
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    case $line in
      '*deleting '*|'deleting '*)
        name=${line#*deleting }; name=${name#"${name%%[![:space:]]*}"}
        [[ $name == */ ]] || printf -- '- %s\n' "$name"
        continue ;;
      rsync:*|'rsync error'*)
        printf '! %s\n' "$line"
        continue ;;
    esac
    code=${line%% *}; name=${line#* }
    case $code in
      '>f+'*) printf '+ %s\n' "$name" ;;
      '>f'*)  printf '* %s\n' "$name" ;;
    esac
  done <<<"$out" >"$results"

  # rsync does not list identical files; derive them for --verbose / --report.
  if (( verbose )) || [[ -n $report ]]; then
    local fargs=()
    for x in ${excludes[@]+"${excludes[@]}"}; do fargs+=(--exclude="$x"); done
    rsync -rn --out-format='%n' ${fargs[@]+"${fargs[@]}"} "${src%/}/" "$tmpbase/cloudcheck-nonexistent-$$/" 2>/dev/null \
      | grep -v '/$' | sort >"$results.all" || true
    cut -c3- "$results" | sort >"$results.diff"
    comm -23 "$results.all" "$results.diff" | sed 's/^/= /' >>"$results"
  fi
}

common_hashes() {
  # Prints the shared hash types, empty if none, or "unknown" if they can't be determined.
  command -v jq >/dev/null || { echo unknown; return; }
  local a b
  a=$(rclone backend features "$src" 2>/dev/null | jq -c '.Hashes // []') || { echo unknown; return; }
  b=$(rclone backend features "$dst" 2>/dev/null | jq -c '.Hashes // []') || { echo unknown; return; }
  jq -nr --argjson a "$a" --argjson b "$b" '($a - ($a - $b)) | join(",")'
}

run_rclone() {
  local args=(check "$src" "$dst" --combined "$results") x
  case $mode in
    size)     args+=(--size-only) ;;
    download) args+=(--download) ;;
    hash)
      local h; h=$(common_hashes)
      if [[ -z $h ]]; then
        log "warning: $src and $dst share no hash type; rclone will compare sizes only."
        log "         Re-run with --download for a byte-level check (downloads both sides)."
      elif [[ $h != unknown ]] && (( verbose )); then
        log "common hashes: $h"
      fi
      ;;
  esac
  (( one_way )) && args+=(--one-way)
  for x in ${excludes[@]+"${excludes[@]}"}; do args+=(--exclude "$x"); done

  (( verbose )) && log "+ rclone ${args[*]}"

  # rclone logs every difference to stderr; keep it unless verbose or on failure.
  local rc=0
  if (( verbose )); then
    rclone "${args[@]}" || rc=$?
  else
    rclone "${args[@]}" 2>"$errlog" || rc=$?
  fi
  # rclone check: 0 = match, 1 = differences; anything else is an operational error.
  if (( rc > 1 )) || { (( rc == 1 )) && [[ ! -s $results ]]; }; then
    cat "$errlog" >&2
    die "rclone failed (exit $rc); check remote names with: rclone listremotes"
  fi
}

log "Comparing ($engine, $mode): $src  ->  $dst"
"run_$engine"

sort -k2 "$results" >"$results.sorted"
if (( one_way )); then
  grep -v '^- ' "$results.sorted" >"$results" || true
else
  mv "$results.sorted" "$results"
fi

count() { grep -c "^$1 " "$results" || true; }
n_same=$(count '=')
n_diff=$(count '\*')
n_src=$(count '+')
n_dst=$(count '-')
n_err=$(count '!')

if (( ! quiet )); then
  if (( verbose )); then cat "$results"; else grep -v '^= ' "$results" || true; fi
fi

[[ -n $report ]] && cp "$results" "$report"

summary="differ: $n_diff  only-in-source: $n_src  errors: $n_err"
(( one_way )) || summary="differ: $n_diff  only-in-source: $n_src  only-in-dest: $n_dst  errors: $n_err"
if [[ $engine == rclone ]] || (( verbose )) || [[ -n $report ]]; then
  summary="identical: $n_same  $summary"
fi
echo "$summary"

if (( n_diff + n_src + n_dst + n_err > 0 )); then
  echo "RESULT: MISMATCH"
  exit 1
fi
echo "RESULT: MATCH"
exit 0
